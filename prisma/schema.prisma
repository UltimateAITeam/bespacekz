generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  emailVerified     DateTime?
  image             String?
  last_name         String?
  location          String?
  phone             String?
  name              String?
  about             String?
  role              Role?
  accounts          Account[]
  birthdate         DateTime?          @default(now())
  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?
  sessions          Session[]
}

model FreelancerProfile {
  id         String       @id @default(cuid())
  completed  Boolean      @default(false)
  userEmail  String       @unique
  jobTitle   String?
  Education  Education[]
  Experience Experience[]
  user       User         @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  Portfolio  Portfolio[]
  Skills     String[]
  Pricing    Pricing[]
  Languages  Language[]
}

model Education {
  id                  Int               @id @default(autoincrement())
  degree              String
  institution         String
  specialization      String
  from                DateTime          @default(now())
  to                  DateTime          @default(now())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Experience {
  id                  Int               @id @default(autoincrement())
  name                String
  jobTitle            String            @default("Freelancer")
  skills              String[]
  tasks               String
  company             String
  country             String            @default("Kazakhstan")
  city                String?
  from                DateTime          @default(now())
  stillWorking        Boolean           @default(false)
  to                  DateTime?
  link                String?
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Language {
  id                  Int               @id @default(autoincrement())
  name                String
  proficiencyLevel    ProficiencyLevel
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Pricing {
  id                  Int               @id @default(autoincrement())
  pricingType         PricingType[]     @default([FREELANCE])
  hourlyRate          Float?
  projectRate         Float?
  employeeRate        Float?
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id                  Int               @id @default(autoincrement())
  links               String[]
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model ClientProfile {
  id                 String    @id @default(cuid())
  companyInfo        String?
  isCompany          Boolean   @default(false)
  sphereOfWork       String?
  address            String?
  mailIndex          String?
  companyDescription String?
  userEmail          String    @unique
  user               User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  Vacancy            Vacancy[]
}

model Vacancy {
  id             String        @id @default(cuid())
  clientId       String
  pricingType    PricingType   @default(FREELANCE)
  aboutVacancy   String
  priceFrom      Float
  priceTo        Float
  currency       CurrencyType      @default(KZT)
  isClear        Boolean       @default(false)
  experience     String
  specialization String
  requiredSkills String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  country        String        @default("Kazakhstan")
  city           String        @default("remote")
  clientProfile  ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobTitleId     Int
  jobTitle       JobTitle      @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
}

model JobTitle {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  category_id Int
  category    JobCategory @relation(fields: [category_id], references: [id])
  Vacancy     Vacancy[]
}

model JobCategory {
  id            Int        @id @default(autoincrement())
  category_name String
  JobTitles     JobTitle[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  FREELANCER
  CLIENT
}

enum ProficiencyLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum PricingType {
  FREELANCE
  EMPLOYEE
}

enum CurrencyType {
  KZT 
  USD 
  EUR 
  RUB
}