generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // url      = env("DATABASE_URL")
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  emailVerified     DateTime?
  image             String?
  name              String?
  last_name         String?
  location          String?
  phone             String?
  accounts          Account[]
  role              Role?
  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?
  sessions          Session[]
}

// FREELANCER PROFILE
model FreelancerProfile {
  id        String @id @default(cuid())
  userEmail String @unique
  user      User   @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  Education  Education[]
  Experience Experience[]
  Skill      Skill[]
  Pricing    Pricing[]
  Portfolio  Portfolio[]
  completed  Boolean      @default(false)
}

model Education {
  id                  Int               @id @default(autoincrement())
  degree              String
  institution         String
  graduationYear      Int
  specialization      String
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Experience {
  id                  Int               @id @default(autoincrement())
  name                String
  roles               String[]
  tasks               String
  duration            String
  company             String
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Skill {
  id                  Int               @id @default(autoincrement())
  name                String
  proficiencyLevel    String
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Pricing {
  id                  Int               @id @default(autoincrement())
  hourlyRate          Float
  projectRate         Float
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id                  Int               @id @default(autoincrement())
  links               String[]
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

// END FREELANCER PROFILE

// CLIENT PROFILE
model ClientProfile {
  id        String    @id @default(cuid())
  userEmail String    @unique
  user      User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  Vacancy   Vacancy[]

  isCompany    Boolean @default(false)
  companyInfo  String?
  sphereOfWork String?
}

// Vacancies
model Vacancy {
  id            String        @id @default(cuid())
  clientId      String        @unique
  clientProfile ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title          String
  aboutVacancy   String
  priceFrom      Float
  priceTo        Float
  currency       String  @default("KZT")
  isClear        Boolean @default(false) // if true - then after taxes, else - before taxes
  experience     String
  specialization String
  city           String  @default("remote") // if remote - then freelancer can work from any city
}

// END CLIENT PROFILE

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  FREELANCER
  CLIENT
}
