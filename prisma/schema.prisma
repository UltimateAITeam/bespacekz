generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String?
  emailVerified     DateTime?
  image             String?
  last_name         String?
  location          String?
  phone             String?
  name              String?
  about             String?
  role              Role?
  accounts          Account[]
  birthdate         DateTime?          @default(now())
  clientProfile     ClientProfile?
  freelancerProfile FreelancerProfile?
  sessions          Session[]
}

model FreelancerProfile {
  id         String       @id @default(cuid())
  completed  Boolean      @default(false)
  userEmail  String       @unique
  jobTitle   String?
  Education  Education[]
  Experience Experience[]
  user       User         @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  Portfolio  Portfolio[]
  Pricing    Pricing[]
  Skill      Skill[]
}

model Education {
  id                  Int               @id @default(autoincrement())
  degree              String
  institution         String
  graduationYear      Int
  specialization      String
  from                DateTime          @default(now())
  to                  DateTime          @default(now())
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Experience {
  id                  Int               @id @default(autoincrement())
  name                String
  roles               String[]
  tasks               String
  company             String
  country             String            @default("Kazakhstan")
  city                String?
  from                DateTime          @default(now())
  to                  DateTime          @default(now())
  link                String?
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Skill {
  id                  Int               @id @default(autoincrement())
  name                String
  proficiencyLevel    String
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Pricing {
  id                  Int               @id @default(autoincrement())
  hourlyRate          Float
  projectRate         Float
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id                  Int               @id @default(autoincrement())
  links               String[]
  freelancerProfileId String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
}

model ClientProfile {
  id                 String    @id @default(cuid())
  companyInfo        String?
  isCompany          Boolean   @default(false)
  sphereOfWork       String?
  address            String?
  mailIndex          String?
  companyDescription String?
  userEmail          String    @unique
  user               User      @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  Vacancy            Vacancy[]
}

model Vacancy {
  id             String        @id @default(cuid())
  clientId       String
  title          String
  aboutVacancy   String
  priceFrom      Float
  priceTo        Float
  currency       String        @default("KZT")
  isClear        Boolean       @default(false)
  experience     String
  specialization String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  city           String        @default("remote")
  clientProfile  ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  FREELANCER
  CLIENT
}
